# ============================================================
# PCM Vận Hành — mẫu cấu hình môi trường
#
# Sao chép file này thành .env rồi sửa theo máy của bạn:
#   Copy-Item .env.example .env
#
# KHÔNG commit file .env: file đó chứa mật khẩu database và admin thật.
# ============================================================

# --- MySQL/MariaDB (XAMPP) -----------------------------------
# Cú pháp: mysql://<user>:<password>@<host>:<port>/<database>
# XAMPP mặc định: user root, mật khẩu rỗng, host localhost, port 3306.
# Nếu mật khẩu có ký tự đặc biệt (@ : / ? # % &), hãy URL-encode hoặc
# đổi sang mật khẩu chỉ gồm chữ và số để tránh lỗi cú pháp URL.
DATABASE_URL=mysql://root:@localhost:3306/pcm_vanhanh

# Số connection tối đa trong pool mysql2 (mặc định 15 nếu không đặt).
DB_POOL_MAX=10

# --- Header proxy tin cậy (tùy chọn) -----------------------------
# Danh sách header chứa IP client thật, PHẢI do reverse proxy của bạn ghi.
# Ví dụ khi chạy sau Caddy: TRUSTED_PROXY_HEADERS=x-forwarded-for
# Cloudflare: TRUSTED_PROXY_HEADERS=cf-connecting-ip
#
# Mặc định (không khai báo) = KHÔNG tin header IP nào. Khi đó rate-limit dùng
# một bucket chung cho mọi client — an toàn hơn là tin header do client tự gửi.
# CHỈ khai báo khi chắc chắn app không bị truy cập trực tiếp (ngoài proxy).
TRUSTED_PROXY_HEADERS=

# --- Tính km giao hàng (tùy chọn) ----------------------------
# Không có key vẫn chạy: API /api/shipping/distance sẽ fallback
# nội suy theo tên quận ở TP.HCM.
GOOGLE_MAPS_API_KEY=

# --- Domain công khai (chỉ cần khi deploy qua Caddy) --------
PUBLIC_DOMAIN=localhost

# --- Tài khoản admin đầu tiên (npm run db:admin) -------------
# Bắt buộc: ADMIN_NAME, ADMIN_USERNAME, ADMIN_PASSWORD, ADMIN_PHONE.
# Hãy đổi mật khẩu ngay sau lần đăng nhập đầu tiên.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@localhost
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-nay
ADMIN_PHONE=0901234567
